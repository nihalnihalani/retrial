# Daytona (sandbox swarm + fork checkpoints) — key from app.daytona.io
DAYTONA_API_KEY=
DAYTONA_TARGET=us
# Fireworks (hypothesis models) — key from the Fireworks dashboard
FIREWORKS_API_KEY=
# CopilotKit evidence navigator (uses the same Fireworks account)
# Disabled by default: set to 1 only when running the local Copilot runtime.
VITE_COPILOT_ENABLED=0
# The runtime stays on loopback and Vite proxies /api/copilotkit to it.
COPILOT_RUNTIME_PORT=4000
# Optional override. When blank, the runtime uses the first FIREWORKS_MODELS
# entry, then the verified fallback accounts/fireworks/models/glm-5p2.
COPILOT_MODEL=
COPILOT_MAX_OUTPUT_TOKENS=800
# Keep local evidence navigation private; CopilotKit otherwise enables
# anonymous runtime telemetry by default.
COPILOTKIT_TELEMETRY_DISABLED=true
# Read-only engine origin used by Copilot tools. Do not expose it publicly.
RETRIAL_ENGINE_URL=http://127.0.0.1:8000
# Braintrust (evidence ledger) — key from the Braintrust settings page
BRAINTRUST_API_KEY=
# GitHub token for PRSmith (or use gh CLI auth)
GITHUB_TOKEN=
# ElevenLabs (spoken verdict autopsy — OUTPUT only, never voice input)
ELEVENLABS_API_KEY=

# Pool backend: snapshot (default, safe) | fork (Rewind engine — one warm root
# frozen as a checkpoint, byte-identical trial clones; auto-falls back to
# snapshot and emits pool_degraded on any fork-path failure)
RETRIAL_POOL_BACKEND=snapshot
# Spend guard: max live fork clones before the fork pool degrades
RETRIAL_MAX_FORKS=64
# Optional one-time bootstrap exec in the fork root (repo/deps/hot caches)
RETRIAL_FORK_BOOTSTRAP_CMD=
# Human promote gate: 1 = a human approves via POST /promote before PRSmith
# opens the PR (default); 0 = auto-PR (headless demos)
PROMOTE_GATE=1
# Verdict narration (default OFF): 1 = after tournament_done, the evidence
# dossier is spoken by ElevenLabs and served at GET /narration/<run_id>.
# Needs ELEVENLABS_API_KEY; degrades to silence, never to a failed run.
NARRATE=0
# Optional overrides — defaults are slugs verified live against the API on
# 2026-07-25 (Matilda / eleven_v3, the model with audio-tag support).
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
