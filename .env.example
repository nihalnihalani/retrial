# Daytona (sandbox swarm + fork checkpoints) — redeem $100: DAYTONA_HACKSPRINT_07_24_639EXIRT at app.daytona.io billing
DAYTONA_API_KEY=
DAYTONA_TARGET=us
# Fireworks (hypothesis models) — redeem via dashboard Credits > Redeem Promo: DEVREL-WEBINAR1
FIREWORKS_API_KEY=
# Braintrust (evidence ledger) — redeem $250: BT-DISCOUNT-HACKATHON via Pro upgrade path
BRAINTRUST_API_KEY=
# GitHub token for PRSmith (or use gh CLI auth)
GITHUB_TOKEN=

# Pool backend: snapshot (default, safe) | fork (Rewind engine — one warm root
# frozen as a checkpoint, byte-identical trial clones; auto-falls back to
# snapshot and emits pool_degraded on any fork-path failure)
RETRIAL_POOL_BACKEND=snapshot
# Spend guard: max live fork clones before the fork pool degrades
RETRIAL_MAX_FORKS=64
# Optional one-time bootstrap exec in the fork root (repo/deps/hot caches)
RETRIAL_FORK_BOOTSTRAP_CMD=
# Human promote gate: 1 = a human approves via POST /promote before PRSmith
# opens the PR (default); 0 = auto-PR (headless demos)
PROMOTE_GATE=1
